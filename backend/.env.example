# Copy the admin settings into backend/.env and replace both values locally.
ADMIN_PASSWORD=replace-with-a-long-unique-demo-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret
ADMIN_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional on Render when a persistent disk is mounted at /var/data:
# DATABASE_URL=sqlite:////var/data/hazard_logs.db
# UPLOAD_DIRECTORY=/var/data/uploads
